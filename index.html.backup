<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generador de Reportes por competencias</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.16.9/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <div class="container">
        <h1>Generador de reportes por competencias</h1>

        <div class="row">
            <div class="column">
                <h3>Cargar Archivo de Estudiantes</h3>
                <input type="file" id="excel-file" accept=".xlsx, .xls">
                <select id="seleccion-hoja">
                    <option value="">Seleccione una hoja</option>
                </select>
                <button onclick="cargarArchivoExcel()">Procesar Archivo</button>
                <div id="progress-bar-container" class="hidden">
                    <div id="progress-bar"></div>
                </div>

                <h3>Seleccionar Estudiante</h3>
                <select id="seleccion-estudiante" multiple size="5">
                </select>
                <button onclick="selectAllStudents()">Seleccionar Todos</button>
                <button onclick="deselectAllStudents()">Deseleccionar Todos</button>
                <button onclick="generarReportePorEstudiante()">Generar Reporte General de Notas por Estudiante</button>
                <div id="student-list-container">
                    <h4>Lista de Estudiantes</h4>
                    <div id="student-list"></div>
                </div>
            </div>
            <div class="column">
                <h3>Evaluaciones y Competencias</h3>
                <input type="number" id="num-parciales" min="1" max="4" placeholder="Número de Parciales" value="4" onchange="actualizarEvaluaciones()">
                <input type="number" id="num-quices" min="1" max="5" placeholder="Número de Quices" value="4" onchange="actualizarEvaluaciones()">
                <div id="seleccion-competencias"></div>
            </div>
        </div>
        <div class="row">
            <div class="full-width-column">
                <h3>Configuración de Evaluación</h3>
                <select id="seleccion-evaluacion">
                    <!-- Opciones se llenan dinámicamente -->
                </select>
                <select id="tipo-comparacion">
                    <option value="lt">Menor que</option>
                    <option value="lte">Menor o igual que</option>
                    <option value="gt">Mayor que</option>
                    <option value="gte">Mayor o igual que</option>
                    <option value="eq">Igual que</option>
                </select>
                <input type="number" id="valor-nota" min="0" max="5" step="0.1" placeholder="Valor de la Nota">
                <div>
                    <input type="checkbox" id="incluir-nombres" checked>
                    <label for="incluir-nombres">Incluir Nombres y Apellidos en el Informe</label>
                </div>
                <button onclick="generarReportePorEvaluacion()">Generar Reporte con Competencias y Recomendaciones</button>
                <button onclick="generarReportePorEvaluacion()">Generar Reporte sin Competencias y Recomendaciones</button>

                <div id="filtered-student-list-container" class="hidden">
                    <h4>Estudiantes que cumplen el criterio</h4>
                    <div id="filtered-student-list"></div>
                    <button onclick="generarReporteParaSeleccionados()">Generar Reporte para Seleccionados</button>
                </div>
            </div>
        </div>

        <div id="excel-popup" class="excel-popup">
            <h3>Seleccione las competencias y sugerencias</h3>
            <div id="excel-content"></div>
            <button onclick="aplicarSeleccion()">Aplicar Selección</button>
            <button onclick="cerrarPopupExcel()">Cerrar</button>
        </div>

        <div id="vista-previa-section" class="hidden">
            <h3>Vista Previa del Reporte</h3>
            <div id="vista-previa-contenido"></div>
            <button onclick="descargarPDF()">Descargar Informe en PDF</button>
            <select id="tamano-hoja">
                <option value="letter">Carta</option>
                <option value="legal">Oficio</option>
            </select>
            <select id="orientacion">
                <option value="p">Vertical</option>
                <option value="l">Horizontal</option>
            </select>
        </div>
    </div>

    <script src="js/main.js?v=1.3"></script>
</body>
</html>